{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/config.schema.json",
  "title": "conductor openspec/config.yaml",
  "type": "object",
  "required": ["schema", "x-conductor"],
  "properties": {
    "schema": { "const": "spec-driven" },
    "context": { "type": "string" },
    "rules": { "type": "object" },
    "x-conductor": {
      "type": "object",
      "required": ["pipeline"],
      "properties": {
        "stack": { "type": "object" },
        "pipeline": {
          "type": "object",
          "description": "DESCRIPTIVO solo: documenta el flujo de fases por defecto. El pipeline EJECUTABLE (reordenar/omitir fases, modelos por fase, lentes, pausas, checks) vive en openspec/conductor.json. El motor NO lee config.yaml.",
          "required": ["phases"],
          "properties": {
            "max_review_cycles": { "type": "integer", "minimum": 0 },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "enum": ["explore", "propose", "clarify", "spec", "design", "tasks", "apply", "verify"] },
                  "optional": { "type": "boolean" },
                  "artifact": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
