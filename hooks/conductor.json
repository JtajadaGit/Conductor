{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash hooks/scripts/session-start.sh",
        "powershell": "pwsh -NoProfile -File hooks\\scripts\\session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "bash hooks/scripts/subagent-start.sh",
        "powershell": "pwsh -NoProfile -File hooks\\scripts\\subagent-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash hooks/scripts/pre-tool-use.sh",
        "powershell": "pwsh -NoProfile -File hooks\\scripts\\pre-tool-use.ps1",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
